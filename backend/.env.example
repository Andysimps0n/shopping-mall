DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

PORT=4000
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
SESSION_SECRET=""
BACKEND_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
KAKAO_REDIRECT_URI="http://localhost:4000/auth/kakao/callback"
NAVER_REDIRECT_URI="http://localhost:4000/auth/naver/callback"

# Names only. Set the real values in backend/.env. Do not commit them.
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# Comma-separated. Either list is enough to open /admin/orders.
ADMIN_USER_IDS=""
ADMIN_EMAILS=""

# Shipping is not fulfilled by this mall. Fee is one config, in KRW.
# 0 means free shipping. Threshold 0 means the fee always applies.
SHIPPING_FEE_KRW=0
FREE_SHIPPING_THRESHOLD_KRW=0