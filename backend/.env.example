DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

PORT=4000
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
SESSION_SECRET=""
BACKEND_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
KAKAO_REDIRECT_URI="http://localhost:4000/auth/kakao/callback"
NAVER_REDIRECT_URI="http://localhost:4000/auth/naver/callback"

# Names only. Set the real values in backend/.env. Do not commit them.
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# Comma-separated. Either list is enough to open /admin/orders.
ADMIN_USER_IDS=""
ADMIN_EMAILS=""

# Express trust proxy. Leave empty in local dev so req.ip is the socket address.
# Behind one known reverse proxy set 1, so rate limits see the visitor IP.
# "true" trusts every hop and lets callers spoof X-Forwarded-For. Prefer a hop count.
TRUST_PROXY=

# Minutes before an unfinished PENDING or CONFIRMING order is re-checked with PortOne and closed.
# Default 15. Closing does not clear the cart. A matching PAID result still does.
ORDER_CONFIRM_TTL_MINUTES=15

# Shipping is not fulfilled by this mall. Fee is one config, in KRW.
# 0 means free shipping. Threshold 0 means the fee always applies.
SHIPPING_FEE_KRW=0
FREE_SHIPPING_THRESHOLD_KRW=0