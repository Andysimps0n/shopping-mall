generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  kakao
  naver
}

model User {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  email          String?
  name           String?
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([provider, providerUserId])
  @@map("users")
}

model Product {
  id    String @id   // e.g. "silk-repair-shampoo" (same ids as products.js)
  price Int          // 원 단위
  // later: name, stock, etc.
  @@map("products")
}