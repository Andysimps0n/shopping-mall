generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 범주형 데이터에 값 제약 넣는 코드 패턴
enum ProductCategory {
  hair
  scalp
  skin
}



model Product {
  id          String           @id
  name        String
  tagline     String
  description String
  price       Int
  category    ProductCategory
  image       String?
  heroImage   String?
  imageZoom   Float?
  story       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@map("products")
}






enum AuthProvider {
  kakao
  naver
}
model User {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  email          String?
  name           String?
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([provider, providerUserId])
  @@map("users")
}

