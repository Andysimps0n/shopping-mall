generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  kakao
  naver
}

// 결제 상태.
// PENDING: 주문을 만들었고 아직 확인을 시작하지 않음.
// CONFIRMING: 결제창이 돌아온 뒤 서버가 PortOne에 확인 중.
// 시간 초과여도 만료 전에는 여기에 머물고, 만료 뒤에 다시 물어도 결제가 아니면 FAILED로 닫는다.
// PAID / FAILED 는 PortOne 조회나 서명된 웹훅이 확정한다.
enum OrderStatus {
  PENDING
  CONFIRMING
  PAID
  FAILED
  CANCELLED
}

model User {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  email          String?
  name           String?
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cart           Cart?
  orders         Order[]
  @@unique([provider, providerUserId])
  @@map("users")
}

// 결제 금액의 기준. id는 frontend/lib/products.js 와 같아야 한다.
model Product {
  id        String     @id
  name      String
  price     Int
  imageUrl  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
  @@map("products")
}

// 로그인한 사용자와 1:1. 가격은 여기 두지 않고 Product.price 를 그때그때 읽는다.
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  itemsTotal     Int
  shippingFee    Int
  totalAmount    Int
  recipientName  String
  phone          String
  postalCode     String
  address1       String
  address2       String      @default("")
  memo           String      @default("")
  payMethod      String
  paymentId      String      @unique
  orderName      String
  failureMessage String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  paidAt         DateTime?
  items          OrderItem[]
  @@index([userId, createdAt])
  @@map("orders")
}

// 주문 시점의 이름과 단가 스냅샷. 이후 상품 가격이 바뀌어도 이 줄은 그대로다.
model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  @@map("order_items")
}

// 결제 직전 로그인으로 보낸 횟수와, 로그인 후 체크아웃으로 돌아온 횟수.
model CheckoutLoginEvent {
  id        String   @id @default(cuid())
  kind      String
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
  @@map("checkout_login_events")
}
