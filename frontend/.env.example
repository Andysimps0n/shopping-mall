# Public values only. Secrets stay in backend/.env.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Names only. Set the real test values in frontend/.env.local. Do not commit them.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KAKAOPAY=
NEXT_PUBLIC_PORTONE_CHANNEL_NAVERPAY=

# Customer inquiry. Leave a line empty to hide that channel on the site.
# 카카오톡 채널 URL. 비우면 카카오 링크를 숨기고 전화 문의를 씁니다.
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# 문의 이메일. 비우면 푸터에 이메일을 보여 주지 않습니다.
NEXT_PUBLIC_INQUIRY_EMAIL=
# 상담 가능 시간 한 줄. 예: 평일 10:00-17:00. 비우면 보여 주지 않습니다.
NEXT_PUBLIC_INQUIRY_HOURS=
